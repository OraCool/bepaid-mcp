# bePaid merchant credentials (Basic auth). Get them from the bePaid merchant dashboard.
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
# true (default) => payment links are created as test transactions. Set to false only for real payments.
BEPAID_TEST_MODE=true
# Time zone used for report date ranges.
BEPAID_TIME_ZONE=Europe/Minsk
# Optional: where the payer is redirected after checkout.
BEPAID_RETURN_URL=
# Optional payer roster workbook (read-only). When set, the roster_* tools are enabled.
ROSTER_XLSX_PATH=/path/to/roster.xlsx
# Where report exports are written.
EXPORT_DIR=./exports
# Language of general export headers: ru (default) or en.
EXPORT_LANGUAGE=ru
# Comma-separated substrings that identify bePaid payment URLs in the roster's payment column
# (e.g. the hostname of your own payment page). URLs containing "bepaid" are always recognized.
ROSTER_BEPAID_URL_MARKERS=
